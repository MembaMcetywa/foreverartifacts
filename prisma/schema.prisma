generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  authProvider    String
  authSubject     String
  email           String    @unique
  emailVerifiedAt DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  albums Album[]
  assets Asset[]

  @@unique([authProvider, authSubject])
}

model Asset {
  id                  String    @id
  userId              String
  key                 String    @unique
  contentType         String
  status              String    @default("pending")
  printKey            String?   @unique
  previewKey          String?   @unique
  width               Int?
  height              Int?
  fileSize            Int?
  failureReason       String?
  processingStartedAt DateTime?
  createdAt           DateTime  @default(now())
  lastActivityAt      DateTime?
  expiresAt           DateTime?
  deletedAt           DateTime?

  user        User         @relation(fields: [userId], references: [id])
  slots       AlbumSlot[]
  albumAssets AlbumAsset[]

  @@index([userId])
}

model Album {
  id                   String    @id
  userId               String
  albumName            String
  albumSpecId          String
  state                String
  workflowStage        String    @default("collect_photos")
  activeSpreadPosition Int?
  renderStatus         String    @default("not_started")
  renderId             String?
  renderArtifactKey    String?
  renderCompletedAt    DateTime?
  renderApprovedAt     DateTime?
  renderExpiresAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastActivityAt       DateTime?
  expiresAt            DateTime?
  deletionRequestedAt  DateTime?
  deletionCompletedAt  DateTime?
  deletedAt            DateTime?

  user    User          @relation(fields: [userId], references: [id])
  spreads AlbumSpread[]
  assets  AlbumAsset[]

  @@index([userId])
}

model AlbumAsset {
  id      String @id
  albumId String
  assetId String
  order   Int

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([albumId, assetId])
  @@unique([albumId, order])
}

model AlbumSpread {
  id         String @id
  albumId    String
  templateId String
  order      Int

  album Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  slots AlbumSlot[]

  @@unique([albumId, order])
}

model AlbumSlot {
  id        String @id
  spreadId  String
  slotIndex Int
  assetId   String

  spread AlbumSpread @relation(fields: [spreadId], references: [id], onDelete: Cascade)
  asset  Asset       @relation(fields: [assetId], references: [id])

  @@unique([spreadId, slotIndex])
}
